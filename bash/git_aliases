# alias gl='git log --oneline --decorate'
alias gslog="git log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all"
# push new branch
alias gitpushu='eval `git push 2>&1 | grep "git push"`'
# get name of repo
alias gname="basename -s .git `git config --get remote.origin.url`"

alias gcstyle='git commit -m "style: style fixes"'
alias gcchore='git commit -m "chore:'
alias gcfix='git commit -m "fix:'
alias gcfeat='git commit -m "feat:'
alias gcrevert='git commit -m "revert:'
alias gcrefactor='git commit -m "refactor:'

alias git-derived=""
git-derived-branch() {
    git checkout -b `git rev-parse --abbrev-ref HEAD`-"$1"
}
