# Npm install alias
alias npi='npm install'
alias npis='npm install --save'
alias npig='npm install -g'
alias npid='npm install --save-dev'

# Npm update
alias npu='npm-check -u'
alias npug='npm update -g'
alias nprm='rm -rf node_modules package-lock.json'

# Npm search
alias nps='npm start'

# Other

alias ndev='yarn dev'
alias nt='yarn test'
alias ntw='yarn test:watch'
alias nbw='yarn test:watch'

alias ys='yarn start'
alias yd='yarn dev'
alias yt='yarn test'
alias yw='yarn test:watch'
alias yb='yarn build'
alias ya='yarn add'
alias ys='yarn storybook'
alias yc='yarn test --clearCache'