alias athena-deploy-heroku-kyc="yarn build know-your-client-ms --webpack && cp -r dist/apps/know-your-client-ms/. ../heroku-kyc-ms && cd ../heroku-kyc-ms/ && git add . && git commit -mupdate && git push heroku master"
